# Copy to .env and fill in. Do not commit .env (it is gitignored).

# --- Core ---
REDIS_ADDR=localhost:6379
API_PORT=8080
METRICS_PORT=9093
WORKER_METRICS_PORT=9094
NUM_WORKERS=4
MAX_ATTEMPTS=3

# --- Security ---
# Browser origin allowed to call the API (the playground). Set to your real
# domain in production, e.g. https://boltq.example.com
ALLOWED_ORIGIN=http://localhost:5173

# Required in production. When set, mutating endpoints (submit job, cancel,
# create/delete workflow) require "X-API-Key: <key>" or "Authorization: Bearer <key>".
# Leave empty ONLY for local dev — an empty key leaves writes unauthenticated.
API_KEY=

# Per-client-IP rate limiting (optional; these are the defaults).
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Grafana admin password — required by docker-compose.prod.yml.
GRAFANA_PASSWORD=

# --- Email (SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=boltq@localhost

# --- Notifications (Pusher Channels) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2

# --- Output directories (optional overrides) ---
# IMAGE_OUTPUT_DIR=./output/images
# REPORT_OUTPUT_DIR=./output/reports
